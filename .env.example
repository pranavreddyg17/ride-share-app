# Public origin used for safe links and notification callbacks.
KY_PUBLIC_ORIGIN=https://your-domain.example

# Bootstrap coordinator. Keep the actual value in your hosting environment.
KY_BOOTSTRAP_ADMIN_EMAIL=coordinator@example.org

# Paths exposed by your identity gateway. The gateway must add verified
# x-ky-authenticated-user-* headers and strip client-supplied copies.
KY_SIGN_IN_PATH=/auth/sign-in
KY_SIGN_OUT_PATH=/auth/sign-out
